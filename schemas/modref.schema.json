{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGS modref stream",
  "type": "object",
  "additionalProperties": false,
  "required": ["func", "global", "access", "via", "witness"],
  "$defs": {
    "global_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unknown"],
          "properties": {
            "unknown": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "func": {
      "type": "string",
      "minLength": 1
    },
    "global": {
      "$ref": "#/$defs/global_target"
    },
    "access": {
      "type": "string",
      "enum": ["ref", "mod"]
    },
    "via": {
      "type": "string",
      "enum": ["direct", "aliased", "unknown"]
    },
    "witness": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "address_node": {
      "type": "string",
      "minLength": 1
    },
    "pointee_globals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "candidate_scope": {
      "type": "string",
      "enum": ["finite", "finite-collapsed", "module-wide"]
    },
    "pointee_global_count": {
      "type": "integer",
      "minimum": 0
    },
    "pointee_global_sample": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "pointee_global_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "global": { "required": ["unknown"] }
        }
      },
      "then": { "required": ["candidate_scope"] }
    }
  ]
}
