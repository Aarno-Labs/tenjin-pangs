{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGS stationarity stream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "complete_initval",
    "stationary",
    "reason",
    "runtime_writers"
  ],
  "$defs": {
    "global_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unknown"],
          "properties": {
            "unknown": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["func", "global", "access", "via", "witness"],
      "properties": {
        "func": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "global": {
          "$ref": "#/$defs/global_target"
        },
        "access": {
          "type": "string",
          "enum": ["mod", "ref"]
        },
        "via": {
          "type": "string",
          "enum": ["direct", "aliased", "unknown"]
        },
        "witness": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "initval_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "witness"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "dynamic_initializer_gep",
            "no_modeled_pointer_initializer",
            "store_address_unresolved",
            "store_value_unresolved",
            "unsupported_initializer_direct_call",
            "unsupported_initializer_indirect_call",
            "unsupported_initializer_inttoptr",
            "unsupported_initializer_memcpy",
            "unsupported_initializer_memset",
            "unsupported_initializer_ptrtoint",
            "unsupported_initializer_unknown"
          ]
        },
        "witness": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "string",
      "minLength": 1
    },
    "complete_initval": {
      "type": "boolean"
    },
    "stationary": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "enum": [
        "stationary",
        "conservative_stage",
        "incomplete_initval",
        "exported_global",
        "runtime_writer",
        "unknown_runtime_writer"
      ]
    },
    "runtime_writers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/writer"
      }
    },
    "initval_diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/initval_diagnostic"
      }
    }
  }
}
