{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGS components",
  "type": "object",
  "additionalProperties": false,
  "required": ["components", "coverage", "context_rewrite"],
  "$defs": {
    "taint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "witness"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "witness": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frozen", "taint", "members", "mutable_globals"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "frozen": {
          "type": "boolean"
        },
        "taint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taint"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mutable_globals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutable_globals_total", "in_rewritable_components"],
      "properties": {
        "mutable_globals_total": {
          "type": "integer",
          "minimum": 0
        },
        "in_rewritable_components": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "context_rewrite_blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "anyOf": [
        {"required": ["function"]},
        {"required": ["initializer"]}
      ],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "callsite": {"type": "string", "minLength": 1},
        "initializer": {"type": "string", "minLength": 1}
      }
    },
    "context_rewrite_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global", "accessors", "functions", "rewrite_callsites", "blockers"],
      "properties": {
        "global": {"type": "string", "minLength": 1},
        "accessors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "functions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rewrite_callsites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/context_rewrite_blocker"}}
      }
    },
    "context_rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "functions", "rewrite_callsites", "fields"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "functions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rewrite_callsites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/context_rewrite_field"}}
      }
    }
  },
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "context_rewrite": {
      "$ref": "#/$defs/context_rewrite"
    }
  }
}
