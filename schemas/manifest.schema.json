{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGS manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pangs_git",
    "llvm_version",
    "input_path",
    "input_sha256",
    "opts",
    "files",
    "wall_ms"
  ],
  "$defs": {
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "records", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "opts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "build_mode",
        "exports",
        "partition_budget",
        "enable_b1_initval",
        "enable_b2_simple",
        "enable_b3_confined",
        "b2_context_depth"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["conservative", "steens", "andersen"]
        },
        "build_mode": {
          "type": "string",
          "enum": ["library", "executable"]
        },
        "exports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "partition_budget": {
          "type": "integer",
          "minimum": 0
        },
        "enable_b1_initval": {
          "type": "boolean"
        },
        "enable_b2_simple": {
          "type": "boolean"
        },
        "enable_b3_confined": {
          "type": "boolean"
        },
        "b2_context_depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pangs_git": {
      "type": "string",
      "minLength": 1
    },
    "llvm_version": {
      "type": "string",
      "minLength": 1
    },
    "input_path": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opts": {
      "$ref": "#/$defs/opts"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_record"
      }
    },
    "wall_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
