{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGS audit stream",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "file", "line", "affected", "effect"],
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Open detector name, for example inline_asm or fnptr_varargs_external."
    },
    "file": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "line": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "affected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(function|global|value|callsite):.+$"
      }
    },
    "effect": {
      "const": "omega_taint"
    }
  }
}
